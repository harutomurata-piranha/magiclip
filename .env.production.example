# 本番の環境変数テンプレート（このファイルはサンプル。実際の値は入れずコミットする）
# 実際の値は PaaS のダッシュボード（環境変数/Secrets）に設定する。ここには本物の鍵を書かない。

APP_ENV=production

# Flaskのセッション署名鍵。必ず長いランダム文字列に（例: python3 -c "import secrets;print(secrets.token_hex(32))"）
SECRET_KEY=change-me-to-a-long-random-string

# AIエンジンの鍵（必須）
OPENAI_API_KEY=sk-xxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# --- 限定公開（知人だけ入れる鍵）---
ACCESS_USER=guest
ACCESS_PASSWORD=set-a-shared-password   # これを設定するとサイト全体にパスワードがかかる

# デモ中は本数無制限にしたい場合は true（本番課金運用なら false のまま）
NO_LIMIT=true

# 課金を使う場合のみ（デモは無料クレジットで回せるので未設定でOK）
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
