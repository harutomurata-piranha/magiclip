# 開発環境（APP_ENV=development のとき読み込まれる）
# ※開発はStripeテストモード・本数制限なし
SECRET_KEY=dev-secret-change-me
DATABASE_URL=sqlite:///magiclip_dev.db

NO_LIMIT=true
FREE_TRIAL_CREDITS=3

PRICE_PAYG_JPY=100
PRICE_MONTHLY_JPY=1980

# Stripeテストキー（sk_test_... / pk_test_...）を入れるとテスト決済が有効になる。
# 空のままなら購入ボタンは「決済シミュレート」で動く（開発用）。
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
